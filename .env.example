# ----------------------------------------
# BACKEND ENVIRONMENT VARIABLES (.env)
# ----------------------------------------

# The port Render will run the app on (Render usually sets this automatically, but good to have)
PORT=5001

# Your MongoDB Atlas Connection String 
# (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/vehicle_care)
MONGODB_URI=mongodb+srv://prasath20012004_db_user:<db_password>@quickapp.oe6qc7k.mongodb.net/?appName=Quickapp

# A secure random string for signing JWT tokens (e.g., a long random sequence of characters)
JWT_SECRET=

# The URL of your deployed Netlify React App (e.g., https://your-app.netlify.app)
# This is required for CORS to allow the frontend to talk to the backend.
FRONTEND_URL=

# Set to "production" when deploying to Render
NODE_ENV=production
